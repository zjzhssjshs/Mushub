-- دالة الأزرار
local function makeButton(txt, onClick)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(32, 20, 20)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = txt
    btn.Parent = scroll

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 6)
    bc.Parent = btn

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.BackgroundColor3 = active and Color3.fromRGB(220, 30, 50) or Color3.fromRGB(32, 20, 20)
        pcall(function() onClick(active) end)
    end)
end

-- دالة القيم
local function makeInput(txt, default, onUpdate)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 46)
    f.BackgroundColor3 = Color3.fromRGB(25, 18, 18)
    f.Parent = scroll

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(0, 6)
    fc.Parent = f

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 0, 18)
    lbl.Position = UDim2.new(0, 5, 0, 2)
    lbl.BackgroundTransparency = 1
    lbl.Text = txt .. ": " .. default
    lbl.TextColor3 = Color3.fromRGB(255, 120, 120)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -10, 0, 20)
    box.Position = UDim2.new(0, 5, 0, 22)
    box.BackgroundColor3 = Color3.fromRGB(45, 25, 25)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 12
    box.Font = Enum.Font.SourceSans
    box.Text = tostring(default)
    box.Parent = f

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 4)
    bc.Parent = box

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then
            if n < 10 then n = 10 end
            if n > 500 then n = 500 end
            box.Text = tostring(n)
            lbl.Text = txt .. ": " .. n
            pcall(function() onUpdate(n) end)
        end
    end)
end

-- ميزات السكربت
local speedVal = 16
makeInput("⚡ سرعة المشي", 16, function(v)
    speedVal = v
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = speedVal end
end)

player.CharacterAdded:Connect(function(char)
    local hum = char:WaitForChild("Humanoid")
    hum.WalkSpeed = speedVal
end)

local flySpeed = 50
makeInput("🕊️ سرعة الطيران", 50, function(v)
    flySpeed = v
end)

local flying = false
local flyConn
makeButton("🕊️ تشغيل/إيقاف الطيران", function(state)
    flying = state
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if flying and root and hum then
        hum.PlatformStand = true
        if flyConn then flyConn:Disconnect() end
        flyConn = RunService.RenderStepped:Connect(function(dt)
            if not flying or not root.Parent then
                if flyConn then flyConn:Disconnect() end
                if hum then hum.PlatformStand = false end
                return
            end
            local cam = workspace.CurrentCamera
            root.CFrame = root.CFrame + (cam.CFrame.LookVector * (flySpeed * dt))
            root.Velocity = Vector3.new(0, 0, 0)
        end)
    else
        if flyConn then flyConn:Disconnect() end
        if hum then hum.PlatformStand = false end
    end
end)

local jumpConn
makeButton("🦘 قفز لانهائي", function(state)
    if state then
        jumpConn = UserInputService.JumpRequest:Connect(function()
            local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
    else
        if jumpConn then jumpConn:Disconnect() end
    end
end)

makeButton("👻 الاختفاء", function(state)
    local char = player.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") or p:IsA("Decal") then
                p.Transparency = state and 1 or 0
            end
        end
    end
end)

makeButton("🌅 جرافيك واقعي (Shaders)", function(state)
    if state then
        local b = Instance.new("BloomEffect", Lighting)
        b.Name = "MusB"
        b.Intensity = 0.5
        local c = Instance.new("ColorCorrectionEffect", Lighting)
        c.Name = "MusC"
        c.Brightness = 0.05
        c.Contrast = 0.25
        Lighting.ClockTime = 14
    else
        if Lighting:FindFirstChild("MusB") then Lighting.MusB:Destroy() end
        if Lighting:FindFirstChild("MusC") then Lighting.MusC:Destroy() end
    end
end)

makeButton("🚀 تخفيف اللاق", function(state)
    if state then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
            elseif v:IsA("ParticleEmitter") or v:IsA("Fire") or v:IsA("Smoke") then
                v.Enabled = false
            end
        end
        Lighting.GlobalShadows = false
    end
end)

